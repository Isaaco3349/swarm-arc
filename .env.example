# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it should already be in .gitignore.

# OpenRouter (orchestrator planning + worker LLM calls)
OPENROUTER_API_KEY=

# Circle (USDC wallet + payments on Arc testnet)
CIRCLE_API_KEY=
CIRCLE_WALLET_ID=

# Gemini (used by worker.ts if/when wired in)
GEMINI_API_KEY=

# Arc testnet RPC, for Hardhat deployment of contracts-hardhat/contracts/ReputationBond.sol
ARC_TESTNET_RPC_URL=

# Deployer private key for contract deployment — TESTNET ONLY, never a real funded key
ARC_DEPLOYER_PRIVATE_KEY=

# x402 / pay-per-call endpoint wallet (app/api/endpoints/route.ts)
AGENT_WALLET=
